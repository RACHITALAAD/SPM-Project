PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/assignment_platform
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173

# Local development keeps files in server/uploads.
FILE_STORAGE=local

# For Render, set FILE_STORAGE=cloudinary and fill these in Render's Environment settings.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
FACULTY_REGISTRATION_CODE=create-a-long-private-faculty-code
